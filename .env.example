# Copy to .env before running docker compose:
#
#   cp .env.example .env
#
# compose.yaml reads .env through env_file, so the file must exist even if you
# leave every value at its default. .env itself is never committed and never
# enters the image.

# --- Required -----------------------------------------------------------
# The application refuses to start without these.
# Generate a key with:  python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=
HAWKI_ADMIN_USERNAME=analyst
HAWKI_ADMIN_PASSWORD=

# --- Local model --------------------------------------------------------
# Leave LLM_API_URL unset to use the vllm service (docker compose --profile llm).
# Point it at host.docker.internal to reach a model running on the workstation.
# LLM_API_URL=http://host.docker.internal:8000/v1/chat/completions
VLLM_MODEL=openai/gpt-oss-20b
VLLM_SERVED_MODEL=hawki-local
VLLM_API_KEY=change-me
VLLM_GPU_MEMORY_UTILIZATION=0.88
VLLM_MAX_MODEL_LEN=32768
VLLM_MAX_NUM_SEQS=4
CUDA_VISIBLE_DEVICES=0

# Fall back to a deterministic summary when the model is unreachable.
# Set false to fail loudly instead.
DEMO_MODE=true

# --- Packet capture -----------------------------------------------------
# File under capture/pcap/ that the suricata service replays.
PCAP_FILE=capture.pcap

# --- Data sources -------------------------------------------------------
# fixture (default) reads data/scenarios; elasticsearch reads a live cluster.
ALERT_REPOSITORY=fixture
# Leave these commented out unless you mean to move the data. .env is read both
# by the container and by anything you run natively, so a container path here
# (/app/data/...) will not exist on the host: the app silently falls back to the
# packaged fixtures and a scenario you just ingested will not appear.
# tools/list_alerts.py prints the directory it is actually reading.
# ALERT_FIXTURE_ROOT=data/scenarios
# ASSET_INVENTORY_ROOT=data/assets
# THREAT_INTEL_ROOT=data/threat_intel

# --- Elasticsearch (Phase 2, AWS stage) ---------------------------------
# Wazuh's indexer is OpenSearch-based and speaks the same API.
ELASTICSEARCH_URL=http://host.docker.internal:9200
ELASTICSEARCH_API_KEY=
# ELASTICSEARCH_USERNAME=
# ELASTICSEARCH_PASSWORD=
# ELASTICSEARCH_ALERT_INDEX=wazuh-alerts-*
# ELASTICSEARCH_EVENT_INDEX=logs-*,winlogbeat-*,packetbeat-*

# Analyst-facing log search on /logs. Off by default: the UI prepares a Kibana
# link instead of querying.
ENABLE_ES_SEARCH=false
KIBANA_URL=http://host.docker.internal:5601

# --- Analysis behaviour -------------------------------------------------
AGENT_CONTEXT_MAX_CHARS=24000
ASSESSMENT_REPAIR_ENABLED=true

# ────────────────────────────────────────────────
# 앱 실행 주소 (python app.py 로 직접 띄울 때만 사용)
# ────────────────────────────────────────────────
FLASK_HOST=127.0.0.1
FLASK_PORT=5050

# ────────────────────────────────────────────────
# AI 분석 연결
#   LLM_API_KEY 는 모델 서버에 붙을 때 필요합니다. 비어 있어도 화면은 동작합니다.
#   AWS GPU 를 SSM 터널로 쓰는 경우 host.docker.internal:8000 그대로 두면 됩니다.
# ────────────────────────────────────────────────
LLM_API_URL=http://host.docker.internal:8000/v1/chat/completions
LLM_MODEL=hawki-local
LLM_API_KEY=

# 증거 번들이 커서 8192 로는 들어가지 않습니다. 답변이 잘리면 이 값을 올리세요.
LLM_MAX_TOKENS=12000
LLM_REQUEST_TIMEOUT=300

# 분석 문장만 한국어로 출력합니다. 식별자와 ATT&CK 명칭은 원문을 유지합니다.
# en 으로 바꾸면 영어 결과와 비교할 수 있습니다.
LLM_OUTPUT_LANGUAGE=ko
