# Copy to .env before running docker compose:
#
#   cp .env.example .env
#
# compose.yaml reads .env through env_file, so the file must exist even if you
# leave every value at its default. .env itself is never committed and never
# enters the image.

# --- Required -----------------------------------------------------------
# The application refuses to start without these.
# Generate a key with:  python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=
HAWKI_ADMIN_USERNAME=analyst
HAWKI_ADMIN_PASSWORD=

# --- Flask dev server ---------------------------------------------------
# Only `python app.py` reads these; gunicorn ignores them and binds itself.
# The code defaults to 0.0.0.0:5000, which listens on every interface, so
# set the host explicitly when you run the app directly on a machine that
# is reachable from anywhere but localhost.
FLASK_HOST=127.0.0.1
FLASK_PORT=5000

# --- Local model --------------------------------------------------------
# Leave LLM_API_URL unset to use the vllm service (docker compose --profile llm).
# Point it at host.docker.internal to reach a model running on the workstation.
# LLM_API_URL=http://host.docker.internal:8000/v1/chat/completions
VLLM_MODEL=openai/gpt-oss-20b
VLLM_SERVED_MODEL=hawki-local
VLLM_API_KEY=change-me
VLLM_GPU_MEMORY_UTILIZATION=0.88
VLLM_MAX_MODEL_LEN=32768
VLLM_MAX_NUM_SEQS=4
CUDA_VISIBLE_DEVICES=0

# Fall back to a deterministic summary when the model is unreachable.
# Set false to fail loudly instead.
DEMO_MODE=true

# --- Packet capture -----------------------------------------------------
# File under capture/pcap/ that the suricata service replays.
PCAP_FILE=capture.pcap

# --- Data sources -------------------------------------------------------
# fixture reads local scenarios; wazuh reads the live Wazuh Indexer.
# Leave these commented out unless you mean to move the data. .env is read both
# by the container and by anything you run natively, so a container path here
# (/app/data/...) will not exist on the host: the app silently falls back to the
# packaged fixtures and a scenario you just ingested will not appear.
# tools/list_alerts.py prints the directory it is actually reading.
# ALERT_FIXTURE_ROOT=data/scenarios
# ASSET_INVENTORY_ROOT=data/assets
# THREAT_INTEL_ROOT=data/threat_intel

# --- Analysis behaviour -------------------------------------------------
AGENT_CONTEXT_MAX_CHARS=24000
ASSESSMENT_REPAIR_ENABLED=true

# ────────────────────────────────────────────────
# 앱 실행 주소 (python app.py 로 직접 띄울 때만 사용)
# ────────────────────────────────────────────────

# ────────────────────────────────────────────────
# AI 분석 연결
#   LLM_API_KEY 는 모델 서버에 붙을 때 필요합니다. 비어 있어도 화면은 동작합니다.
#   AWS GPU 를 SSM 터널로 쓰는 경우 host.docker.internal:8000 그대로 두면 됩니다.
# ────────────────────────────────────────────────
LLM_API_URL=http://host.docker.internal:8000/v1/chat/completions
LLM_MODEL=hawki-local
LLM_API_KEY=

# 증거 번들이 커서 8192 로는 들어가지 않습니다. 답변이 잘리면 이 값을 올리세요.
LLM_MAX_TOKENS=12000
LLM_REQUEST_TIMEOUT=300

# 분석 문장만 한국어로 출력합니다. 식별자와 ATT&CK 명칭은 원문을 유지합니다.
# en 으로 바꾸면 영어 결과와 비교할 수 있습니다.
LLM_OUTPUT_LANGUAGE=ko

# --- Wazuh SIEM ---------------------------------------------------------
ALERT_REPOSITORY=wazuh
WAZUH_INDEXER_URL=https://wazuh.indexer:9200
WAZUH_INDEXER_USERNAME=admin
WAZUH_INDEXER_PASSWORD=
WAZUH_ALERT_INDEX=wazuh-alerts-*
WAZUH_EVENT_INDEX=wazuh-alerts-*
WAZUH_TIMESTAMP_FIELD=timestamp
WAZUH_TIMEOUT=20
WAZUH_ALERT_LIMIT=100
WAZUH_CANDIDATE_LIMIT=200
WAZUH_WINDOW_SECONDS=300
ENABLE_WAZUH_SEARCH=true
WAZUH_VERIFY_TLS=false
WAZUH_CA_BUNDLE=
WAZUH_DASHBOARD_INTERNAL_URL=https://wazuh.dashboard
WAZUH_DASHBOARD_BROWSER_URL=https://127.0.0.1:18443
WAZUH_API_URL=https://10.0.10.123:55000
WAZUH_API_USERNAME=hawki-service
WAZUH_API_PASSWORD=
WAZUH_API_VERIFY_TLS=false
WAZUH_API_TIMEOUT=10
WAZUH_API_TOKEN_TTL=840
WAZUH_ARCHIVE_INDEX=wazuh-archives-*

# --- Adaptive evidence gathering (evidence_agent.py) -----------------------
# Before a live analysis the model may call read-only tools (widen the time
# window, search an address across agents, look up an asset or indicator).
# Each call is one more LLM request, so it starts off.
AGENT_TOOL_LOOP_ENABLED=false
AGENT_MAX_TOOL_CALLS=3

# --- Language of API error messages ----------------------------------------
# ko: Korean `error` for the screen, original English kept in `error_en`.
# en: English only. `code` and HTTP status never change.
API_MESSAGE_LANGUAGE=ko

# --- Red team auto-evaluation (hawki_alert_analysis/redteam_bridge.py) ------
# Sends each live Wazuh analysis (never fixture or demo) to the red team runner
# on siem-redteam in the background. Keep false until the runner and token are
# confirmed. The token must match the runner's; never commit or message it.
REDTEAM_AUTO_EVAL_ENABLED=false
REDTEAM_RUNNER_URL=http://10.0.10.59:8091
REDTEAM_RUNNER_TOKEN=
REDTEAM_AUTO_TOOLS=promptfoo
REDTEAM_RUNNER_TIMEOUT=3

# --- Automatic analysis and reports (hawki_alert_analysis/auto_report.py) ---
# The hawki-worker container reads new Wazuh alerts at or above MIN_LEVEL and
# writes a report for those whose deterministic priority is in BANDS or that
# match a live threat-intelligence indicator. The report is written at once
# from facts; the AI section is filled when the model answers (at most
# MAX_PER_HOUR a hour) and waits while the GPU is off. Proposed actions are
# never queued automatically. Starts off.
AUTO_ANALYSIS_ENABLED=false
AUTO_ANALYSIS_MIN_LEVEL=8
AUTO_ANALYSIS_BANDS=P1,P2
AUTO_ANALYSIS_MAX_PER_HOUR=20
AUTO_ANALYSIS_GROUP_SECONDS=600
AUTO_ANALYSIS_POLL_SECONDS=60
AUTO_ANALYSIS_LOOKBACK_SECONDS=900
AUTO_ANALYSIS_PENDING_TTL_SECONDS=86400
# Also send automatic analyses to the red team runner (needs
# REDTEAM_AUTO_EVAL_ENABLED=true as well). Off: the runner sees only analyses
# an analyst started.
AUTO_ANALYSIS_FORWARD_REDTEAM=false

# --- Analyst feedback in the next analysis (hawki_alert_analysis/feedback.py) --
# Verdicts (확인됨 / 오탐 / 추가 조사) from the alert page and from automatic
# report reviews are always recorded in data/analyst_feedback.jsonl. When true,
# up to three settled verdicts on the same rule AND the same host or source
# (last 90 days) are added to the next analysis as context -- never as evidence,
# never changing the deterministic priority. Retrieval, not fine-tuning.
ANALYST_FEEDBACK_CONTEXT_ENABLED=false
