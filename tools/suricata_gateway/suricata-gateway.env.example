# /etc/hawki/suricata-gateway.env  (chmod 600, root 소유)
# 토큰은 HAW-KI .env 의 SURICATA_GATEWAY_TOKEN 과 같은 값. 채팅·Git에 올리지 않습니다.
HAWKI_GW_TOKEN=
# 센서의 사설 IP 로만 엽니다. 0.0.0.0 금지.
HAWKI_GW_BIND=10.0.10.235
HAWKI_GW_PORT=8095
# suricata.yaml 의 rule-files 에 hawki.rules 를 넣고, default-rule-path 폴더에 둡니다.
HAWKI_GW_RULES_FILE=/etc/suricata/rules/hawki.rules
HAWKI_GW_SURICATA_CONF=/etc/suricata/suricata.yaml
# 탐지 전용 센서: alert 만 허용 (drop 을 넣어도 막지 못하므로)
HAWKI_GW_ALLOWED_ACTIONS=alert
# HAW-KI 조치의 호스트·인터페이스가 이 값과 다르면 거부
HAWKI_GW_SENSOR_HOST=10.0.10.235
HAWKI_GW_SENSOR_INTERFACE=ens5
# 명령은 JSON 목록입니다. systemd 가 큰따옴표를 지우므로 값 전체를 작은따옴표로 감쌉니다.
# 소켓 경로는 suricata.yaml 의 unix-command.filename 과 같아야 합니다.
HAWKI_GW_TEST_CMD='["suricata","--set","unix-command.enabled=no","-T","-c","{conf}","-S","{rules}"]'
HAWKI_GW_RELOAD_CMD='["suricatasc","-c","ruleset-reload-nonblocking","/var/run/suricata-command.socket"]'
HAWKI_GW_STATUS_CMD='["pidof","suricata"]'
# 앞 변경의 룰 다시 읽기(ET 룰이면 2~3분)가 끝나기 전에 온 요청은 409 로 돌려보냅니다.
HAWKI_GW_RELOAD_TIME_CMD='["suricatasc","-c","ruleset-reload-time","/var/run/suricata-command.socket"]'
# Suricata 를 컨테이너로 돌릴 때 (예: 컨테이너 이름 suricata)
# HAWKI_GW_TEST_CMD='["docker","exec","suricata","suricata","--set","unix-command.enabled=no","-T","-c","{conf}","-S","{rules}"]'
# HAWKI_GW_RELOAD_CMD='["docker","exec","suricata","suricatasc","-c","ruleset-reload-nonblocking"]'
# HAWKI_GW_STATUS_CMD='["docker","exec","suricata","pidof","suricata"]'

